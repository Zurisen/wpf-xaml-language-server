<Window x:Class="SampleWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SampleWpfApp"
        xmlns:lib="clr-namespace:SampleWpfLib;assembly=SampleWpfLib"
        mc:Ignorable="d"
        Title="Sample" Height="300" Width="400"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}">
  <Window.Resources>
    <local:InverseBooleanConverter x:Key="Inverse" />
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <TextBlock Text="{Binding Greeting}" FontWeight="Bold" Foreground="{StaticResource LibAccentBrush}" Background="{StaticResource AccentBrush}" />
    <StackPanel Grid.Row="1" Orientation="Horizontal">
      <local:BadgeControl Count="3" />
      <lib:TagControl Content="New" IsHighlighted="True" />
      <Button x:Name="OkButton" Content="OK" Click="OnOkClick"
              IsEnabled="{Binding IsBusy, Converter={StaticResource Inverse}}" />
    </StackPanel>
  </Grid>
</Window>
